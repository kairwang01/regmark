{
  "name": "regmark",
  "version": "0.2.0",
  "description": "Catch price, stock and shipping mismatches between product pages, JSON-LD, merchant feeds, AI shopping-agent endpoints (UCP, MCP, ACP) and checkout. CLI and GitHub Action for WooCommerce and Shopify.",
  "keywords": [
    "ecommerce",
    "woocommerce",
    "shopify",
    "google-merchant-center",
    "product-feed",
    "json-ld",
    "structured-data",
    "schema.org",
    "data-quality",
    "price-parity",
    "cli",
    "github-actions",
    "sarif",
    "agentic-commerce",
    "testing",
    "ucp",
    "mcp",
    "acp",
    "ai-agents",
    "github-action",
    "merchant-center",
    "price-monitoring"
  ],
  "homepage": "https://opensource.kairwang.cloud/regmark/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kairwang01/regmark.git"
  },
  "bugs": {
    "url": "https://github.com/kairwang01/regmark/issues"
  },
  "license": "Apache-2.0",
  "author": "Kair Wang",
  "type": "module",
  "bin": {
    "regmark": "dist/regmark.mjs"
  },
  "files": [
    "dist/regmark.mjs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/quickstart.md",
    "docs/configuration.md",
    "docs/rules.md",
    "docs/report-format.md",
    "docs/ci.md",
    "docs/demo.md",
    "docs/positioning.md"
  ],
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "test": "node --test \"packages/*/test/**/*.test.ts\" \"fixtures/*/test/**/*.test.ts\"",
    "bench": "node --test \"e2e/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "regmark": "node packages/cli/src/bin.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm bench && node scripts/bundle.mjs --check",
    "check": "pnpm typecheck && pnpm test && pnpm bench && node scripts/bundle.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
